{
    "name": "mathsgod/light-xml",
    "description": "LINQ-style XML construction, querying and editing for PHP",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Raymond Chong",
            "homepage": "https://github.com/mathsgod"
        }
    ],
    "keywords": ["xml", "linq", "xml-reader", "xml-writer"],
    "support": {
        "issues": "https://github.com/mathsgod/light-xml/issues",
        "source": "https://github.com/mathsgod/light-xml"
    },
    "require": {
        "php": ">=8.3",
        "ext-dom": "*",
        "mathsgod/light-linq": "^1.0"
    },
    "suggest": {
        "ext-xmlreader": "Enables the Light\\Xml\\XmlReader API.",
        "ext-xmlwriter": "Enables the Light\\Xml\\XmlWriter API.",
        "mathsgod/light-io": "Install ^1.0 to load XML from a TextReader or save XML to a TextWriter."
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Light\\Xml\\Linq\\": "src/linq/",
            "Light\\Xml\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
