{
    "name": "mathsgod/php-xml",
    "description": "LINQ-style XML construction, querying and editing for PHP",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-dom": "*",
        "mathsgod/php-linq": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "mathsgod/light-collections": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../light-linq",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../light-collections",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Light\\Xml\\Linq\\": "src/linq/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
